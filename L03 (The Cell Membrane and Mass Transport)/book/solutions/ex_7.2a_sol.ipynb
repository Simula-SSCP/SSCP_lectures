   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "\n",
    "def V_target(t):\n",
    "    return -80 + 40 * (t > 2) * (t < 6)\n",
    "\n",
    "\n",
    "t = np.linspace(0, 10, 101)\n",
    "\n",
    "plt.plot(t, V_target(t))\n",
    "plt.xlabel(\"Time (ms)\")\n",
    "plt.ylabel(\"Voltage (mV)\")\n",
    "plt.show()"
   ]
  }
