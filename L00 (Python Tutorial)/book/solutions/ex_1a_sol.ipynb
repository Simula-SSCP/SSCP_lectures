   "source": [
    "from math import pi\n",
    "\n",
    "R = 6371  # km\n",
    "V = (4 / 3) * pi * R**3  # km^3\n",
    "\n",
    "print(f\"The volume of Earth is {V:.3e} km^3\")"
   ]
