     "text": [
      "The sum of all multiples of 3 or 5 below 1000 is 233168\n"
     ]
    }
   ],
   "source": [
    "total_sum = 0\n",
    "\n",
    "for n in range(1, 1000):\n",
    "    if (n % 3 == 0) or (n % 5 == 0):\n",
    "        total_sum += n\n",
    "\n",
    "print(f\"The sum of all multiples of 3 or 5 below 1000 is {total_sum}\")"
   ]
  }
