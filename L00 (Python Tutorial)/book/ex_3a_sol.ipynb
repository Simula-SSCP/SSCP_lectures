   ],
   "source": [
    "total_squares = 64\n",
    "total_grains = 0\n",
    "\n",
    "for square in range(total_squares):\n",
    "    # Note: 'square' goes from 0 to 63, which correctly maps to 2^0, 2^1, etc.\n",
    "    total_grains += 2**square\n",
    "\n",
    "print(f\"The total number of rice grains is {total_grains:.1e}\")"
   ]
  }
